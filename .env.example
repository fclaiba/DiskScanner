# .env.example — DiskScanner Turbo (monorepo)
# Nunca commitear valores reales. Toda variable nueva se agrega acá (y en web/.env.example) con su comentario.
# La web lee web/.env.local; el desktop lee variables de entorno del proceso.

# ============================================================
# WEB (web/.env.local) — lista completa y comentada en web/.env.example
# ============================================================
# Postgres de producción (Neon) o PGlite local: pglite:./.data/dev  |  tests: pglite://memory
DATABASE_URL=pglite:./.data/dev
# URL pública del sitio, sin barra final
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Link directo al instalador
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/fclaiba/DiskScanner/releases/latest/download/DiskScannerTurbo.exe
# Stripe (claves test en local/preview, live solo en producción)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_TRIAL_DAYS=7
STRIPE_AUTOMATIC_TAX=false
# Firma de entitlements (node web/scripts/generate-entitlement-keys.mjs)
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_KEY_ID=k1
# Email transaccional (vacío = los emails se imprimen en la consola)
RESEND_API_KEY=
EMAIL_FROM="DiskScanner Turbo <hello@example.com>"
# Protege /api/cron/cleanup (openssl rand -hex 32)
CRON_SECRET=

# ============================================================
# DESKTOP (variables de entorno del proceso / secretos de GitHub para el release)
# ============================================================
# Backend al que se conecta el desktop (por defecto https://diskscanner.app)
DISKSCANNER_API_URL=http://localhost:3000
# Clave pública de entitlements "kid:base64raw" (sale del script de claves)
DISKSCANNER_ENTITLEMENT_PUBKEY=
# Solo desarrollo: habilita todo sin cuenta. NUNCA en un build distribuido.
# DISKSCANNER_SKIP_LICENSE=1
