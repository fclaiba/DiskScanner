# DiskScanner Turbo — web platform environment
# Copy to .env.local for local development. Never commit real secrets.

# --- Core --------------------------------------------------------------------
# Postgres connection string (Neon / Vercel Postgres in production; use the
# pooled URL). For local dev without Postgres, use embedded PGlite:
#   pglite:./.data/dev   -> persisted in a local directory (default if unset)
#   pglite://memory      -> in-memory, wiped on restart (tests / e2e)
DATABASE_URL=pglite:./.data/dev

# Public base URL of this site, no trailing slash. Used for links in emails,
# Stripe return URLs, the device verification_uri and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the "Download" buttons point (Windows .exe).
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/fclaiba/DiskScanner/releases/latest/download/DiskScannerTurbo.exe

# Structured log level: debug | info | warn | error | silent
LOG_LEVEL=info

# Note: no AUTH_SECRET is needed — sessions are random opaque tokens stored
# hashed (sha256) in the database.

# --- Entitlement signing (Ed25519) --------------------------------------------
# Generate with: npm run keys:generate   (node scripts/generate-entitlement-keys.mjs)
# Private key, base64 PKCS#8 DER. SECRET.
ENTITLEMENT_SIGNING_KEY=
# Key id embedded in each signed entitlement ("kid"), for rotation.
ENTITLEMENT_KEY_ID=k1

# --- Stripe --------------------------------------------------------------------
# Secret API key (sk_test_… / sk_live_…). If unset, billing buttons show
# "billing not configured" instead of crashing.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for the Pro product.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Free trial length for first-time subscribers (0 disables). Default 7.
STRIPE_TRIAL_DAYS=7
# "true" to enable Stripe Tax on Checkout (requires Stripe Tax set up).
STRIPE_AUTOMATIC_TAX=false

# --- Email (Resend) ------------------------------------------------------------
# If unset, emails (with their links) are printed to the server console (dev).
RESEND_API_KEY=
# Verified sender, e.g. "DiskScanner Turbo <no-reply@diskscanner.app>"
EMAIL_FROM=DiskScanner Turbo <no-reply@diskscanner.app>

# --- Cron ------------------------------------------------------------------------
# Bearer secret for /api/cron/cleanup (Vercel Cron sends it automatically when
# CRON_SECRET is set in the project). Generate: openssl rand -base64 32
CRON_SECRET=
